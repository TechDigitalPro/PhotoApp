<?xml version="1.0" encoding="utf-8"?>
<com.cambe.cartooneffecteditor.chooser.BottomSheetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomsheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!--android:background="0x1060000"-->
        <project.android.imageprocessing.FastImageProcessingView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#ffffff">

        </RelativeLayout>


        <FrameLayout
            android:id="@+id/image_edit_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

            <RelativeLayout
                android:id="@+id/image_edit_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <!--android:background="0x106000e"-->
        </FrameLayout>

        <RelativeLayout
            android:id="@+id/image_edit_topbar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/shadow"
            android:padding="5dp">
            <!--android:background="0x106000c"-->
            <ImageView
                android:id="@+id/image_edit_save"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:layout_margin="5dp"
                android:src="@drawable/save" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Cartoon Artist"
                android:textColor="#323232"
                android:textSize="24dp" />

            <ImageView
                android:id="@+id/back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:layout_margin="5dp"
                android:src="@drawable/back" />
            <!--android:textColor="0x106000b"-->
        </RelativeLayout>

        <com.cambe.cartooneffecteditor.utils.CustomImageView
            android:id="@+id/view_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/image_edit_layout"
            android:layout_below="@+id/image_edit_topbar"
            android:layout_margin="3dp" />
    </RelativeLayout>
</com.cambe.cartooneffecteditor.chooser.BottomSheetLayout>
